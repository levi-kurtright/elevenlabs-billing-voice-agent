{
  "type": "webhook",
  "name": "check_invoice_status",
  "description": "Looks up billing status in Stripe. This is read-only and never changes anything. Call it when the caller asks whether an invoice is paid, what they owe, or the status of a specific invoice. If the caller gives an invoice number, pass invoice_number. Otherwise pass dealer with their dealer number, the email on the account, or the company name to see their open invoices and balance. Read back the spoken_summary from the result word for word. Never invent a status, amount, or invoice number.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "api_schema": {
    "url": "https://YOUR-STRIPE-VAL.web.val.run/status",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "The billing-status lookup. Provide either invoice_number or dealer.",
      "properties": [
        {
          "id": "invoice_number",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "A specific Stripe invoice number the caller gives, for example CPGODWZY-0001. Leave empty if the caller does not have one.",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        },
        {
          "id": "dealer",
          "type": "object",
          "description": "The caller's account, used when there is no invoice number. Provide at least one identifier.",
          "properties": [
            {
              "id": "id",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer number, for example D-1042",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "email",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Email on the account",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "name",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Company or dealer name",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
