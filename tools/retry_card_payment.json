{
  "type": "webhook",
  "name": "retry_card_payment",
  "description": "Has Stripe retry a failed automatic card payment right now instead of waiting for the next scheduled retry, after the account owner has updated the card. First call with confirmed false: it reads back the amount and asks. Call again with confirmed true only after the caller clearly says yes. Read back the spoken_summary word for word. Never take card details.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "api_schema": {
    "url": "https://YOUR-STRIPE-VAL.web.val.run/payment/retry",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "Request body",
      "properties": [
        {
          "id": "dealer",
          "type": "object",
          "description": "The caller's dealer account",
          "properties": [
            {
              "id": "id",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer number, for example D-3002",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": true
            },
            {
              "id": "name",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer or company name, if the caller gave it",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            }
          ],
          "required": true,
          "dynamic_variable": "",
          "value_type": "llm_prompt"
        },
        {
          "id": "invoice_number",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "The invoice number, if the caller named one",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        },
        {
          "id": "confirmed",
          "type": "boolean",
          "value_type": "llm_prompt",
          "description": "false to read back the charge first; true only after the caller clearly said yes to the read-back",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        }
      ],
      "required": false,
      "dynamic_variable": "",
      "value_type": "llm_prompt"
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "response_filter": null
  },
  "assignments": [],
  "response_timeout_secs": 30,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "response_mocks": []
}