{
  "type": "webhook",
  "name": "send_payment_link",
  "description": "Has Stripe email the secure payment page for a dealer's open invoice to the billing email already on file. Use when a caller wants to pay an invoice, or asks how to pay or fix a past-due balance. Never send it to an email address the caller reads out, and never take card or bank numbers. Read back the spoken_summary word for word. If card_billed is true, the account owner updates the card in Summit's billing portal; once they say it's updated, offer retry_card_payment.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "api_schema": {
    "url": "https://YOUR-STRIPE-VAL.web.val.run/payment/link",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "Request body",
      "properties": [
        {
          "id": "dealer",
          "type": "object",
          "description": "The caller's dealer account",
          "properties": [
            {
              "id": "id",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer number, for example D-3002",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": true
            },
            {
              "id": "name",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer or company name, if the caller gave it",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            }
          ],
          "required": true,
          "dynamic_variable": "",
          "value_type": "llm_prompt"
        },
        {
          "id": "invoice_number",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "The invoice number, if the caller named one, for example KIJK8SG7-0005",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        }
      ],
      "required": false,
      "dynamic_variable": "",
      "value_type": "llm_prompt"
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "response_filter": null
  },
  "assignments": [],
  "response_timeout_secs": 30,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "response_mocks": []
}